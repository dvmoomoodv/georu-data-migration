<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="georu.t6h.TbMemberAllSourceMapper">
  <select id="selectTotalCount" resultType="int">SELECT COUNT(*) FROM stg_member_all</select>
  <select id="selectPageData" resultType="map">SELECT SRC_CD, ID, NM FROM stg_member_all ORDER BY SRC_CD, ID LIMIT #{_pagesize} OFFSET #{_skiprows}</select>
</mapper>
