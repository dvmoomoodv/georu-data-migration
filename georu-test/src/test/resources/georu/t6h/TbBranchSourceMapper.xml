<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="georu.t6h.TbBranchSourceMapper">
  <select id="selectTotalCount" resultType="int">SELECT COUNT(*) FROM BRANCH</select>
  <select id="selectPageData" resultType="map">SELECT BR_CD, BR_NM FROM BRANCH ORDER BY BR_CD LIMIT #{_pagesize} OFFSET #{_skiprows}</select>
</mapper>
