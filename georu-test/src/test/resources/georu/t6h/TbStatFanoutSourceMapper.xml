<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="georu.t6h.TbStatFanoutSourceMapper">
  <select id="selectTotalCount" resultType="int">SELECT COUNT(*) FROM STAT</select>
  <select id="selectPageData" resultType="map">SELECT YMD, AMT FROM STAT ORDER BY YMD LIMIT #{_pagesize} OFFSET #{_skiprows}</select>
</mapper>
