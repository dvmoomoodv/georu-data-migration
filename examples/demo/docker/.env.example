# docker compose 환경변수 (복사: cp docker/.env.example docker/.env). docker/.env 는 git 에 추적되므로 실제 비밀번호·토큰은 넣지 않는다.
# compose 실행 시 --env-file docker/.env 를 쓰거나 run-scripts/run-docker.sh 를 사용한다.

# ---- 앱 ----
APP_PORT=8083
APP_MEM_LIMIT=3g                 # Docker Desktop 메모리 기준. 메모리 상향 시 6g~12g
APP_LOG_LEVEL=INFO               # georu.log.level (com.georu). docker 프로파일 기본 DEBUG 를 컨테이너에서는 INFO 로
APP_LOG_SQL_LEVEL=INFO           # georu.log.sql-level (MyBatis/JDBC SQL 로거)
APP_ADMIN_CONSOLE_ENABLED=true   # 서버 진단 화면 (Spring Boot Admin, /admin). false 면 /admin·메뉴 없음
SPRING_PROFILES_ACTIVE=docker
H2_TCP_PORT=9093                 # 운영저장소 H2 TCP 호스트 포트 (127.0.0.1 바인딩). DBeaver: jdbc:h2:tcp://localhost:9093//app/data/operation/migops
# JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:+UseZGC ...   # Dockerfile 기본값 덮어쓰기

# ---- 소스: Oracle (gvenzl/oracle-free) ----
ORACLE_PORT=1523
ORACLE_PDB=FREEPDB1
ORACLE_SYS_PASSWORD=oracle       # SYS / SYSTEM
ORACLE_APP_USER=migrator         # 앱 접속 계정 (데모 스키마 DEMO 에 SELECT 권한)
ORACLE_APP_PASSWORD=migrator
ORACLE_MEM_LIMIT=3g

# ---- 타겟: MySQL ----
MYSQL_PORT=3308
MYSQL_DATABASE=demo_tobe         # docker/mysql/init/20_demo_tobe_schema.sql 의 DB 명과 동일해야 함
MYSQL_ROOT_PASSWORD=password
MYSQL_MEM_LIMIT=1g

# ---- 텔레그램 알림 (모든 프로파일 enabled=true) ----
# TELEGRAM_BOT_TOKEN=123456:ABC...          # 비우면 알림은 UI 알림 화면에만 쌓이고 텔레그램 전송은 건너뛴다(로그)
# TELEGRAM_CHAT_ID=-1001234567890

# ---- 여러 DB 예제 demo.xdb (profile xdb, ./run-scripts/run-docker.sh xdb) ----
DEMO_XDB_ENABLED=false           # run-docker.sh xdb 가 true 로 띄운다. 직접 켜려면 true + docker compose --profile xdb up
POSTGRES_PORT=5434               # 소스 source-2 PostgreSQL demo_pg (계정 demo)
POSTGRES_PASSWORD=demo
MSSQL_PORT=1434                  # 소스 source-3 SQL Server(Azure SQL Edge) demo_ms (앱 계정 migrator, 읽기 전용)
MSSQL_SA_PASSWORD=Georu!Demo2026
MSSQL_APP_PASSWORD=Migrator!2026
MARIADB_PORT=3309                # 타겟 target-2 MariaDB demo_mart
MARIADB_ROOT_PASSWORD=password
