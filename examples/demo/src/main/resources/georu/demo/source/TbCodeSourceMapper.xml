<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Source] TOBE tb_code : 코드 ← ASIS(Oracle) CD_CODE : 코드 (매핑 추정, 미확정)
     자동 매핑 8 / 수기 매핑 2 (TOBE 컬럼 10, apply_demo_mapping.py 적용)
     자동 생성: 코드 생성기 -->
<mapper namespace="georu.demo.code.TbCodeSourceMapper">

    <sql id="where">
        WHERE 1 = 1
    </sql>

    <select id="testSelect" resultType="int">
        SELECT 1 FROM DUAL
    </select>

    <select id="selectTotalCount" parameterType="com.georu.common.dto.CommonSourceDto" resultType="int">
        SELECT COUNT(*)
          FROM "DEMO"."CD_CODE" A
        <include refid="where"/>
    </select>

    <!-- ASIS → TOBE 컬럼 변환. 별칭 = TOBE 컬럼명 -->
    <select id="selectPageData" parameterType="com.georu.common.dto.CommonSourceDto"
            resultType="com.georu.examples.demo.source.dto.TbCodeSourceDto">
        SELECT
              A."GROUP_CD" AS "GROUP_CD"    <!-- 그룹코드 VARCHAR(20) ← GROUP_CD (이름 일치 자동, 의미 확인) -->
            , A."CODE" AS "CODE"    <!-- 코드 VARCHAR(20) ← CODE (이름 일치 자동, 의미 확인) -->
            , A."CODE_NM" AS "CODE_NM"    <!-- 코드명 VARCHAR(100) ← CODE_NM (이름 일치 자동, 의미 확인) -->
            , A."CODE_DESC" AS "CODE_DESC"    <!-- 설명 VARCHAR(500) ← CODE_DESC (이름 일치 자동, 의미 확인) -->
            , A."USE_YN" AS "USE_YN"    <!-- 사용여부 CHAR(1) ← USE_YN (이름 일치 자동, 의미 확인) -->
            , A."SORT_NO" AS "SORT_NO"    <!-- 정렬순서 INT ← SORT_NO (이름 일치 자동, 의미 확인) -->
            , A."REG_ID" AS "INUSERID"    <!-- 등록자 VARCHAR(40) ← REG_ID (수기) -->
            , TO_CHAR(A."REG_DATE", 'YYYYMMDDHH24MISS') AS "INDATE"    <!-- 등록일시 VARCHAR(14) ← REG_DATE (감사 컬럼) -->
            , A."MOD_ID" AS "LUSERID"    <!-- 수정자 VARCHAR(40) ← MOD_ID (수기) -->
            , TO_CHAR(A."MOD_DATE", 'YYYYMMDDHH24MISS') AS "LDATE"    <!-- 수정일시 VARCHAR(14) ← MOD_DATE (감사 컬럼) -->
          FROM "DEMO"."CD_CODE" A
        <include refid="where"/>
         ORDER BY A."GROUP_CD", A."CODE"
        OFFSET #{_skiprows} ROWS FETCH NEXT #{_pagesize} ROWS ONLY
    </select>

</mapper>
