<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Source] TOBE tb_post_comment : 게시글댓글 ← ASIS(Oracle) BRD_COMMENT : 댓글 (매핑 추정, 미확정)
     자동 매핑 9 / 수기 매핑 2 (TOBE 컬럼 11, apply_demo_mapping.py 적용)
     자동 생성: 코드 생성기 -->
<mapper namespace="georu.demo.board.TbPostCommentSourceMapper">

    <sql id="where">
        WHERE 1 = 1
        AND A."STATUS" &lt;&gt; 'D'    <!-- 삭제 댓글 제외 -->
    </sql>

    <select id="testSelect" resultType="int">
        SELECT 1 FROM DUAL
    </select>

    <select id="selectTotalCount" parameterType="com.georu.common.dto.CommonSourceDto" resultType="int">
        SELECT COUNT(*)
          FROM "DEMO"."BRD_COMMENT" A
        <include refid="where"/>
    </select>

    <!-- ASIS → TOBE 컬럼 변환. 별칭 = TOBE 컬럼명 -->
    <select id="selectPageData" parameterType="com.georu.common.dto.CommonSourceDto"
            resultType="com.georu.examples.demo.source.dto.TbPostCommentSourceDto">
        SELECT
              A."COMMENT_ID" AS "COMMENT_ID"    <!-- 댓글ID BIGINT ← COMMENT_ID (이름 일치 자동, 의미 확인) -->
            , A."POST_ID" AS "POST_ID"    <!-- 게시글ID BIGINT ← POST_ID (이름 일치 자동, 의미 확인) -->
            , A."PARENT_ID" AS "PARENT_ID"    <!-- 부모댓글ID BIGINT ← PARENT_ID (이름 일치 자동, 의미 확인) -->
            , A."WRITER_ID" AS "WRITER_ID"    <!-- 작성자 INT ← WRITER_ID (이름 일치 자동, 의미 확인) -->
            , A."CONTENT" AS "CONTENT"    <!-- 내용 VARCHAR(2000) ← CONTENT (이름 일치 자동, 의미 확인) -->
            , A."DEPTH" AS "DEPTH"    <!-- 깊이 TINYINT ← DEPTH (이름 일치 자동, 의미 확인) -->
            , A."STATUS" AS "STATUS"    <!-- 상태 VARCHAR(10) ← STATUS (이름 일치 자동, 의미 확인) -->
            , A."REG_ID" AS "INUSERID"    <!-- 등록자 VARCHAR(40) ← REG_ID (수기) -->
            , TO_CHAR(A."REG_DATE", 'YYYYMMDDHH24MISS') AS "INDATE"    <!-- 등록일시 VARCHAR(14) ← REG_DATE (감사 컬럼) -->
            , A."MOD_ID" AS "LUSERID"    <!-- 수정자 VARCHAR(40) ← MOD_ID (수기) -->
            , TO_CHAR(A."MOD_DATE", 'YYYYMMDDHH24MISS') AS "LDATE"    <!-- 수정일시 VARCHAR(14) ← MOD_DATE (감사 컬럼) -->
          FROM "DEMO"."BRD_COMMENT" A
        <include refid="where"/>
         ORDER BY A."COMMENT_ID"
        OFFSET #{_skiprows} ROWS FETCH NEXT #{_pagesize} ROWS ONLY
    </select>

</mapper>
