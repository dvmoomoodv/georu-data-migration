<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Source] TOBE tb_member_grade : 회원등급 ← ASIS(Oracle) MEM_GRADE : 회원 등급 (매핑 추정, 미확정)
     자동 매핑 7 / 수기 매핑 2 (TOBE 컬럼 9, apply_demo_mapping.py 적용)
     자동 생성: 코드 생성기 -->
<mapper namespace="georu.demo.member.TbMemberGradeSourceMapper">

    <sql id="where">
        WHERE 1 = 1
    </sql>

    <select id="testSelect" resultType="int">
        SELECT 1 FROM DUAL
    </select>

    <select id="selectTotalCount" parameterType="com.georu.common.dto.CommonSourceDto" resultType="int">
        SELECT COUNT(*)
          FROM "DEMO"."MEM_GRADE" A
        <include refid="where"/>
    </select>

    <!-- ASIS → TOBE 컬럼 변환. 별칭 = TOBE 컬럼명 -->
    <select id="selectPageData" parameterType="com.georu.common.dto.CommonSourceDto"
            resultType="com.georu.examples.demo.source.dto.TbMemberGradeSourceDto">
        SELECT
              A."GRADE_CD" AS "GRADE_CD"    <!-- 등급코드 VARCHAR(10) ← GRADE_CD (이름 일치 자동, 의미 확인) -->
            , A."GRADE_NM" AS "GRADE_NM"    <!-- 등급명 VARCHAR(50) ← GRADE_NM (이름 일치 자동, 의미 확인) -->
            , A."MIN_POINT" AS "MIN_POINT"    <!-- 최소포인트 INT ← MIN_POINT (이름 일치 자동, 의미 확인) -->
            , A."DISCOUNT_RATE" AS "DISCOUNT_RATE"    <!-- 할인율 DECIMAL(5,2) ← DISCOUNT_RATE (이름 일치 자동, 의미 확인) -->
            , A."USE_YN" AS "USE_YN"    <!-- 사용여부 CHAR(1) ← USE_YN (이름 일치 자동, 의미 확인) -->
            , A."REG_ID" AS "INUSERID"    <!-- 등록자 VARCHAR(40) ← REG_ID (수기) -->
            , TO_CHAR(A."REG_DATE", 'YYYYMMDDHH24MISS') AS "INDATE"    <!-- 등록일시 VARCHAR(14) ← REG_DATE (감사 컬럼) -->
            , A."MOD_ID" AS "LUSERID"    <!-- 수정자 VARCHAR(40) ← MOD_ID (수기) -->
            , TO_CHAR(A."MOD_DATE", 'YYYYMMDDHH24MISS') AS "LDATE"    <!-- 수정일시 VARCHAR(14) ← MOD_DATE (감사 컬럼) -->
          FROM "DEMO"."MEM_GRADE" A
        <include refid="where"/>
         ORDER BY A."GRADE_CD"
        OFFSET #{_skiprows} ROWS FETCH NEXT #{_pagesize} ROWS ONLY
    </select>

</mapper>
