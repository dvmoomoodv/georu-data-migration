<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Source] TOBE tb_post_file : 게시글첨부 ← ASIS(Oracle) BRD_POST_FILE : 첨부파일 (매핑 추정, 미확정)
     자동 매핑 8 / 수기 매핑 4 (TOBE 컬럼 12, apply_demo_mapping.py 적용)
     자동 생성: 코드 생성기 -->
<mapper namespace="georu.demo.board.TbPostFileSourceMapper">

    <sql id="where">
        WHERE 1 = 1
    </sql>

    <select id="testSelect" resultType="int">
        SELECT 1 FROM DUAL
    </select>

    <select id="selectTotalCount" parameterType="com.georu.common.dto.CommonSourceDto" resultType="int">
        SELECT COUNT(*)
          FROM "DEMO"."BRD_POST_FILE" A
        <include refid="where"/>
    </select>

    <!-- ASIS → TOBE 컬럼 변환. 별칭 = TOBE 컬럼명 -->
    <select id="selectPageData" parameterType="com.georu.common.dto.CommonSourceDto"
            resultType="com.georu.examples.demo.source.dto.TbPostFileSourceDto">
        SELECT
              NULL AS "FILE_ID"    <!-- 파일ID BIGINT ← 시퀀스 채번 (DemoSequenceColumns) -->
            , A."FILE_ID" AS "ASIS_ID"    <!-- ASIS파일ID BIGINT ← FILE_ID (원본 보존) -->
            , A."POST_ID" AS "POST_ID"    <!-- 게시글ID BIGINT ← POST_ID (이름 일치 자동, 의미 확인) -->
            , A."ORIGIN_NM" AS "ORIGIN_NM"    <!-- 원본파일명 VARCHAR(255) ← ORIGIN_NM (이름 일치 자동, 의미 확인) -->
            , A."STORED_PATH" AS "FILE_PATH"    <!-- 저장경로 VARCHAR(500) ← STORED_PATH (수기, 경로 변환은 Processor) -->
            , A."FILE_SIZE" AS "FILE_SIZE"    <!-- 크기 BIGINT ← FILE_SIZE (이름 일치 자동, 의미 확인) -->
            , A."MIME_TYPE" AS "MIME_TYPE"    <!-- MIME VARCHAR(100) ← MIME_TYPE (이름 일치 자동, 의미 확인) -->
            , A."DOWNLOAD_CNT" AS "DOWNLOAD_CNT"    <!-- 다운로드수 INT ← DOWNLOAD_CNT (이름 일치 자동, 의미 확인) -->
            , A."REG_ID" AS "INUSERID"    <!-- 등록자 VARCHAR(40) ← REG_ID (수기) -->
            , TO_CHAR(A."REG_DATE", 'YYYYMMDDHH24MISS') AS "INDATE"    <!-- 등록일시 VARCHAR(14) ← REG_DATE (감사 컬럼) -->
            , A."MOD_ID" AS "LUSERID"    <!-- 수정자 VARCHAR(40) ← MOD_ID (수기) -->
            , TO_CHAR(A."MOD_DATE", 'YYYYMMDDHH24MISS') AS "LDATE"    <!-- 수정일시 VARCHAR(14) ← MOD_DATE (감사 컬럼) -->
          FROM "DEMO"."BRD_POST_FILE" A
        <include refid="where"/>
         ORDER BY A."FILE_ID"
        OFFSET #{_skiprows} ROWS FETCH NEXT #{_pagesize} ROWS ONLY
    </select>

</mapper>
