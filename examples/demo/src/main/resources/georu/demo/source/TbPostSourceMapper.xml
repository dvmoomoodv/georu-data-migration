<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Source] TOBE tb_post : 게시글 ← ASIS(Oracle) BRD_POST : 게시글 (매핑 추정, 미확정)
     자동 매핑 11 / 수기 매핑 2 (TOBE 컬럼 13, apply_demo_mapping.py 적용)
     자동 생성: 코드 생성기 -->
<mapper namespace="georu.demo.board.TbPostSourceMapper">

    <sql id="where">
        WHERE 1 = 1
        AND A."STATUS" &lt;&gt; 'D'    <!-- 삭제 게시글 제외 -->
        <if test="startDate != null and startDate != ''">AND A."REG_DATE" &gt;= TO_DATE(#{startDate}, 'YYYYMMDD')</if>
        <if test="endDate != null and endDate != ''">AND A."REG_DATE" &lt; TO_DATE(#{endDate}, 'YYYYMMDD') + 1</if>
    </sql>

    <select id="testSelect" resultType="int">
        SELECT 1 FROM DUAL
    </select>

    <select id="selectTotalCount" parameterType="com.georu.common.dto.CommonSourceDto" resultType="int">
        SELECT COUNT(*)
          FROM "DEMO"."BRD_POST" A
        <include refid="where"/>
    </select>

    <!-- ASIS → TOBE 컬럼 변환. 별칭 = TOBE 컬럼명 -->
    <select id="selectPageData" parameterType="com.georu.common.dto.CommonSourceDto"
            resultType="com.georu.examples.demo.source.dto.TbPostSourceDto">
        SELECT
              A."POST_ID" AS "POST_ID"    <!-- 게시글ID BIGINT ← POST_ID (이름 일치 자동, 의미 확인) -->
            , A."BOARD_ID" AS "BOARD_ID"    <!-- 게시판ID INT ← BOARD_ID (이름 일치 자동, 의미 확인) -->
            , A."TITLE" AS "TITLE"    <!-- 제목 VARCHAR(200) ← TITLE (이름 일치 자동, 의미 확인) -->
            , A."CONTENT" AS "CONTENT"    <!-- 본문 LONGTEXT ← CONTENT (이름 일치 자동, 의미 확인) -->
            , A."WRITER_ID" AS "WRITER_ID"    <!-- 작성자 INT ← WRITER_ID (이름 일치 자동, 의미 확인) -->
            , A."VIEW_CNT" AS "VIEW_CNT"    <!-- 조회수 INT ← VIEW_CNT (이름 일치 자동, 의미 확인) -->
            , A."NOTICE_YN" AS "NOTICE_YN"    <!-- 공지여부 CHAR(1) ← NOTICE_YN (이름 일치 자동, 의미 확인) -->
            , A."SECRET_YN" AS "SECRET_YN"    <!-- 비밀글 CHAR(1) ← SECRET_YN (이름 일치 자동, 의미 확인) -->
            , A."STATUS" AS "STATUS"    <!-- 상태 VARCHAR(10) ← STATUS (이름 일치 자동, 의미 확인) -->
            , A."REG_ID" AS "INUSERID"    <!-- 등록자 VARCHAR(40) ← REG_ID (수기) -->
            , TO_CHAR(A."REG_DATE", 'YYYYMMDDHH24MISS') AS "INDATE"    <!-- 등록일시 VARCHAR(14) ← REG_DATE (감사 컬럼) -->
            , A."MOD_ID" AS "LUSERID"    <!-- 수정자 VARCHAR(40) ← MOD_ID (수기) -->
            , TO_CHAR(A."MOD_DATE", 'YYYYMMDDHH24MISS') AS "LDATE"    <!-- 수정일시 VARCHAR(14) ← MOD_DATE (감사 컬럼) -->
          FROM "DEMO"."BRD_POST" A
        <include refid="where"/>
         ORDER BY A."POST_ID"
        OFFSET #{_skiprows} ROWS FETCH NEXT #{_pagesize} ROWS ONLY
    </select>

</mapper>
