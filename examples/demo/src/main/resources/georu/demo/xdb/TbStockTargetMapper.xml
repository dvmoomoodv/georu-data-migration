<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- [Target] target-2 MariaDB demo_mart.tb_stock -->
<mapper namespace="georu.demo.xdb.TbStockTargetMapper">
    <insert id="insertData" parameterType="com.georu.examples.demo.xdb.dto.TbStockDto">
        INSERT INTO `tb_stock` (`STOCK_ID`, `PRODUCT_CD`, `WAREHOUSE_CD`, `QTY`, `UPD_DATE`)
        VALUES (#{stockId}, #{productCd}, #{warehouseCd}, #{qty}, #{updDate})
    </insert>
</mapper>
