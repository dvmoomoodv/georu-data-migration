<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- [Target] target-2 MariaDB demo_mart.tb_customer -->
<mapper namespace="georu.demo.xdb.TbCustomerTargetMapper">
    <insert id="insertData" parameterType="com.georu.examples.demo.xdb.dto.TbCustomerDto">
        INSERT INTO `tb_customer` (`CUSTOMER_SEQ`, `ASIS_ID`, `LOGIN_ID`, `CUSTOMER_NM`, `GRADE_CD`, `JOIN_DATE`)
        VALUES (#{customerSeq}, #{asisId}, #{loginId}, #{customerNm}, #{gradeCd}, #{joinDate})
    </insert>
</mapper>
