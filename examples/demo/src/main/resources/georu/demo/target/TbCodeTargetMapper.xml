<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Target] TOBE(MySQL) tb_code : 코드 (업무 01 코드관리) / 자동 생성: 코드 생성기 -->
<mapper namespace="georu.demo.code.TbCodeTargetMapper">

    <select id="testSelect" resultType="int">
        SELECT 1
    </select>

    <insert id="insertData" parameterType="com.georu.examples.demo.target.dto.TbCodeTargetDto">
        INSERT INTO `demo_tobe`.`tb_code` (
              `GROUP_CD`    <!-- VARCHAR(20) 그룹코드 -->
            , `CODE`    <!-- VARCHAR(20) 코드 -->
            , `CODE_NM`    <!-- VARCHAR(100) 코드명 -->
            , `CODE_DESC`    <!-- VARCHAR(500) 설명 -->
            , `USE_YN`    <!-- CHAR(1) 사용여부 -->
            , `SORT_NO`    <!-- INT 정렬순서 -->
            , `INUSERID`    <!-- VARCHAR(40) 등록자 -->
            , `INDATE`    <!-- VARCHAR(14) 등록일시 -->
            , `LUSERID`    <!-- VARCHAR(40) 수정자 -->
            , `LDATE`    <!-- VARCHAR(14) 수정일시 -->
        ) VALUES (
              #{groupCd}
            , #{code}
            , #{codeNm}
            , #{codeDesc}
            , #{useYn}
            , #{sortNo}
            , #{inuserid}
            , #{indate}
            , #{luserid}
            , #{ldate}
        )
        <!-- PK 있음. 재실행은 제품 정책상 "기존 데이터 있으면 경고 후 중단" → 데모 리셋 SQL(21_demo_tobe_reset.sql) 후 재실행 -->
    </insert>

</mapper>
