<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Target] TOBE(MySQL) tb_board : 게시판 (업무 03 게시판) / 자동 생성: 코드 생성기 -->
<mapper namespace="georu.demo.board.TbBoardTargetMapper">

    <select id="testSelect" resultType="int">
        SELECT 1
    </select>

    <insert id="insertData" parameterType="com.georu.examples.demo.target.dto.TbBoardTargetDto">
        INSERT INTO `demo_tobe`.`tb_board` (
              `BOARD_ID`    <!-- INT 게시판ID -->
            , `BOARD_CD`    <!-- VARCHAR(30) 게시판코드 -->
            , `BOARD_NM`    <!-- VARCHAR(100) 게시판명 -->
            , `BOARD_TYPE_CD`    <!-- VARCHAR(10) 유형 -->
            , `USE_YN`    <!-- CHAR(1) 사용여부 -->
            , `ANON_YN`    <!-- CHAR(1) 익명허용 -->
            , `ATTACH_LIMIT`    <!-- TINYINT 첨부최대수 -->
            , `INUSERID`    <!-- VARCHAR(40) 등록자 -->
            , `INDATE`    <!-- VARCHAR(14) 등록일시 -->
            , `LUSERID`    <!-- VARCHAR(40) 수정자 -->
            , `LDATE`    <!-- VARCHAR(14) 수정일시 -->
        ) VALUES (
              #{boardId}
            , #{boardCd}
            , #{boardNm}
            , #{boardTypeCd}
            , #{useYn}
            , #{anonYn}
            , #{attachLimit}
            , #{inuserid}
            , #{indate}
            , #{luserid}
            , #{ldate}
        )
        <!-- PK 있음. 재실행은 제품 정책상 "기존 데이터 있으면 경고 후 중단" → 데모 리셋 SQL(21_demo_tobe_reset.sql) 후 재실행 -->
    </insert>

</mapper>
