<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Target] TOBE(MySQL) tb_notice_template : 공지 템플릿 (업무 04 공지) / 이관 상태: 이관 제외 -->
<mapper namespace="georu.demo.notice.TbNoticeTemplateTargetMapper">

    <select id="testSelect" resultType="int">
        SELECT 1
    </select>

    <insert id="insertData" parameterType="com.georu.examples.demo.target.dto.TbNoticeTemplateTargetDto">
        INSERT INTO `demo_tobe`.`tb_notice_template` (
              `TEMPLATE_ID`    <!-- INT 템플릿ID -->
            , `TEMPLATE_NM`    <!-- VARCHAR(100) 템플릿명 -->
            , `BODY`    <!-- VARCHAR(2000) 본문 서식 -->
            , `USE_YN`    <!-- CHAR(1) 사용여부 1/0 -->
            , `INUSERID`    <!-- VARCHAR(40) 등록자 -->
            , `INDATE`    <!-- VARCHAR(14) 등록일시 -->
            , `LUSERID`    <!-- VARCHAR(40) 수정자 -->
            , `LDATE`    <!-- VARCHAR(14) 수정일시 -->
        ) VALUES (
              #{templateId}
            , #{templateNm}
            , #{body}
            , #{useYn}
            , #{inuserid}
            , #{indate}
            , #{luserid}
            , #{ldate}
        )
    </insert>

</mapper>
