<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Target] TOBE(MySQL) tb_post_file : 게시글첨부 (업무 03 게시판) / 자동 생성: 코드 생성기 -->
<mapper namespace="georu.demo.board.TbPostFileTargetMapper">

    <select id="testSelect" resultType="int">
        SELECT 1
    </select>

    <insert id="insertData" parameterType="com.georu.examples.demo.target.dto.TbPostFileTargetDto">
        INSERT INTO `demo_tobe`.`tb_post_file` (
              `FILE_ID`    <!-- BIGINT 파일ID -->
            , `ASIS_ID`    <!-- BIGINT ASIS파일ID -->
            , `POST_ID`    <!-- BIGINT 게시글ID -->
            , `ORIGIN_NM`    <!-- VARCHAR(255) 원본파일명 -->
            , `FILE_PATH`    <!-- VARCHAR(500) 저장경로 -->
            , `FILE_SIZE`    <!-- BIGINT 크기 -->
            , `MIME_TYPE`    <!-- VARCHAR(100) MIME -->
            , `DOWNLOAD_CNT`    <!-- INT 다운로드수 -->
            , `INUSERID`    <!-- VARCHAR(40) 등록자 -->
            , `INDATE`    <!-- VARCHAR(14) 등록일시 -->
            , `LUSERID`    <!-- VARCHAR(40) 수정자 -->
            , `LDATE`    <!-- VARCHAR(14) 수정일시 -->
        ) VALUES (
              #{fileId}
            , #{asisId}
            , #{postId}
            , #{originNm}
            , #{filePath}
            , #{fileSize}
            , #{mimeType}
            , #{downloadCnt}
            , #{inuserid}
            , #{indate}
            , #{luserid}
            , #{ldate}
        )
        <!-- PK 있음. 재실행은 제품 정책상 "기존 데이터 있으면 경고 후 중단" → 데모 리셋 SQL(21_demo_tobe_reset.sql) 후 재실행 -->
    </insert>

</mapper>
