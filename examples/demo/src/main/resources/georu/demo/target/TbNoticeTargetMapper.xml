<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Target] TOBE(MySQL) tb_notice : 공지사항 (업무 04 공지) / 이관 상태: 수행 -->
<mapper namespace="georu.demo.notice.TbNoticeTargetMapper">

    <select id="testSelect" resultType="int">
        SELECT 1
    </select>

    <insert id="insertData" parameterType="com.georu.examples.demo.target.dto.TbNoticeTargetDto">
        INSERT INTO `demo_tobe`.`tb_notice` (
              `NOTICE_ID`    <!-- INT 공지ID -->
            , `TITLE`    <!-- VARCHAR(200) 제목 -->
            , `CONTENT`    <!-- VARCHAR(2000) 내용 -->
            , `NOTICE_TYPE`    <!-- VARCHAR(10) 공지유형 GENERAL/URGENT/EVENT -->
            , `TOP_YN`    <!-- CHAR(1) 상단고정 1/0 -->
            , `VIEW_CNT`    <!-- INT 조회수 -->
            , `POST_START_YMD`    <!-- VARCHAR(8) 게시시작일 -->
            , `INUSERID`    <!-- VARCHAR(40) 등록자 -->
            , `INDATE`    <!-- VARCHAR(14) 등록일시 -->
            , `LUSERID`    <!-- VARCHAR(40) 수정자 -->
            , `LDATE`    <!-- VARCHAR(14) 수정일시 -->
        ) VALUES (
              #{noticeId}
            , #{title}
            , #{content}
            , #{noticeType}
            , #{topYn}
            , #{viewCnt}
            , #{postStartYmd}
            , #{inuserid}
            , #{indate}
            , #{luserid}
            , #{ldate}
        )
    </insert>

</mapper>
