<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- [Target] TOBE(MySQL) tb_banner : 배너 (업무 04 공지) / 이관 상태: 대기 -->
<mapper namespace="georu.demo.notice.TbBannerTargetMapper">

    <select id="testSelect" resultType="int">
        SELECT 1
    </select>

    <insert id="insertData" parameterType="com.georu.examples.demo.target.dto.TbBannerTargetDto">
        INSERT INTO `demo_tobe`.`tb_banner` (
              `BANNER_ID`    <!-- INT 배너ID -->
            , `BANNER_NM`    <!-- VARCHAR(100) 배너명 -->
            , `IMAGE_PATH`    <!-- VARCHAR(300) 이미지 경로 -->
            , `LINK_URL`    <!-- VARCHAR(500) 링크 -->
            , `SORT_NO`    <!-- INT 정렬순서 -->
            , `USE_YN`    <!-- CHAR(1) 사용여부 1/0 -->
            , `INUSERID`    <!-- VARCHAR(40) 등록자 -->
            , `INDATE`    <!-- VARCHAR(14) 등록일시 -->
            , `LUSERID`    <!-- VARCHAR(40) 수정자 -->
            , `LDATE`    <!-- VARCHAR(14) 수정일시 -->
        ) VALUES (
              #{bannerId}
            , #{bannerNm}
            , #{imagePath}
            , #{linkUrl}
            , #{sortNo}
            , #{useYn}
            , #{inuserid}
            , #{indate}
            , #{luserid}
            , #{ldate}
        )
    </insert>

</mapper>
