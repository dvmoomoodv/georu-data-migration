{
  "id": "demo-multi",
  "name": "여러 DB 전체",
  "description": "demo-2to1 → demo-1to2 → demo-2to2 를 차례로 (겹치는 단위는 한 번). 각 시나리오의 건수 기준을 모두 확인한다 (docker 프로파일, guides/demo.md 의 \"여러 DB\")",
  "profiles": [
    "docker"
  ],
  "onUnitFailure": "STOP",
  "onStepStop": "STOP_ALL",
  "common": {
    "tenantLevel1": "DEMO",
    "tenantLevel2": "DEMO",
    "tenantLevel3": "DEMO",
    "tenantLevel4": "DEMO",
    "tenantLevel5": "DEMO",
    "chunkSize": 500
  },
  "steps": [
    {
      "plugin": "demo.multi",
      "table": "tb_branch",
      "label": "지점 (2:1 테이블별 소스: source-1 → target-m)"
    },
    {
      "plugin": "demo.multi",
      "table": "stg_member_hq",
      "label": "회원 합치기 - 본사 (2:1 합치기, src_cd HQ)"
    },
    {
      "plugin": "demo.multi",
      "table": "stg_member_br",
      "label": "회원 합치기 - 지사 (2:1 합치기, src_cd BR)"
    },
    {
      "plugin": "demo.multi",
      "table": "tb_member_point",
      "label": "회원 포인트 (2:1 결합: SourceLookup)"
    },
    {
      "plugin": "demo.code",
      "table": "tb_code",
      "label": "코드 (→ target-m)"
    },
    {
      "plugin": "demo.multi",
      "table": "tb_code_to_dw",
      "label": "코드 (1:2 복제 → target-1)"
    },
    {
      "plugin": "demo.member",
      "table": "tb_member",
      "label": "회원 (→ target-m)"
    },
    {
      "plugin": "demo.multi",
      "table": "tb_member_contact",
      "label": "회원 연락처 (1:2 나누기 → target-1)"
    },
    {
      "plugin": "demo.board",
      "table": "tb_post",
      "label": "게시글 (→ target-m)"
    },
    {
      "plugin": "demo.multi",
      "table": "tb_post_notice",
      "label": "공지 게시글 (1:2 조건 분기 → target-1)"
    },
    {
      "plugin": "demo.multi",
      "table": "tb_stat_daily_fanout",
      "label": "일별통계 (1:2 한 번 읽어 두 곳에 쓰기)"
    },
    {
      "plugin": "demo.multi",
      "table": "tb_br_member",
      "label": "지사 회원 (2:2 짝지어 나누기 → target-1, target-m 에서 채번)"
    },
    {
      "plugin": "demo.multi",
      "table": "tb_member_all",
      "label": "전체 회원 (2:2 2단계 적재: target-m → target-1)"
    },
    {
      "plugin": "demo.multi",
      "table": "tb_member_point_dw",
      "label": "회원 포인트 (2:2 결합 후 나누기 → target-1)"
    }
  ]
}
